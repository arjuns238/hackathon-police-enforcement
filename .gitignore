.DS_Store
*.pyc
__pycache__/
.ipynb_checkpoints/
.venv/

# local configs that hold the Jupyter token (written by new_project.sh)
.env
.mcp.json
.codex/
.claude/settings.local.json

# azure/: a generated YAML would hold the registry password and Jupyter token (the scripts use temp files,
# but just in case one is ever saved into the repo)
azure/*.yaml
azure/*.yml

# large artifacts stay on the GPU share / pod volume
artifacts/activations/
artifacts/checkpoints/
hf-cache/
acts/
*.npz
*.safetensors
*.pt
# to keep one small fitted artifact, whitelist it explicitly, e.g.
# !results/my_probe_dirs.npz

# pod-side Jupyter server log (noise)
pod_logs/**/jupyter.log

# vendored third-party code with no licence file (Agrawal et al., andyjliu/llm-agent-collusion @ 2bb2a7e2);
# keep it out of the repo. Recreate: clone at that commit into vendor/llm-agent-collusion, delete data/,
# then `git apply patches/agrawal_market_claude.patch` from inside it.
# Also SALT-NLP/agent-collusion @ 5afb2c59 (MIT): clone into vendor/agent-collusion, then
# `git apply patches/agent_collusion_haiku.patch`, `ln -s ../../.env .env`, and make a .venv from requirements.txt.
vendor/
